# ─────────────────────────────────────────────────────────────────────────────
# iCAD Dispatch v2 — Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Required values are marked with [REQUIRED].
# Optional values have sensible defaults.
#
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────── Logging ───────────────
# 0 = silent, 1 = errors, 2 = warnings+info, 3 = debug (very noisy)
LOG_LEVEL=2

# ─────────────── Timezone ───────────────
# IANA timezone name for your dispatch region.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York

# ─────────────── Base URL ───────────────
# The URL where your iCAD dashboard will be accessible.
# Use your public domain with HTTPS in production.
# [REQUIRED]
BASE_URL=https://dispatch.YOUR_DOMAIN.COM

# ─────────────── Session Cookies ───────────────
# SESSION_COOKIE_SECURE must be True when using HTTPS in production.
# SESSION_COOKIE_DOMAIN should match your BASE_URL domain.
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_DOMAIN=YOUR_DOMAIN.COM
SESSION_COOKIE_NAME=icad_dispatch
SESSION_COOKIE_PATH=/

# ─────────────── Database ───────────────
# PostgreSQL connection details.
# When using Docker Compose, these match the postgres service.
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=icad_dispatch
PG_USER=icad
# [REQUIRED] Change this to a strong password in production
PG_PASSWORD=change-me-to-a-strong-password

# ─────────────── Public Map ───────────────
# API key shared between icad_dispatch and public_map containers.
# [REQUIRED] Generate a long random string.
PUBLIC_MAP_API_KEY=change-me-to-a-long-random-api-key

# Secret key for Flask-SocketIO session signing in the public map.
# [REQUIRED] Generate a long random string (different from above).
MAP_SECRET_KEY=change-me-to-another-long-random-string

# Public-facing URL of the live map (used for shared map images).
PUBLIC_MAP_BASE_URL=https://map.YOUR_DOMAIN.COM

# Local Nominatim instance used by public-map address search.
NOMINATIM_BASE_URL=http://192.168.90.115
# Comma-separated browser origins allowed to open Socket.IO connections.
PUBLIC_MAP_CORS_ORIGINS=http://192.168.90.104:5000

# ─────────────── Root User Bootstrap ───────────────
# The first admin account created on first boot.
# [REQUIRED] Change the password before deploying!
ROOT_USERNAME=root
ROOT_PASSWORD=change-me-before-first-boot

# You can also use a file instead of inline password:
# ROOT_PASSWORD_FILE=/run/secrets/root_password

# ─────────────── Optional: Google Maps Geocoding ───────────────
# Only needed if you want Google as a geocoding fallback.
# Get a key at: https://developers.google.com/maps/documentation/geocoding/get-api-key
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─────────────── Optional: OpenAI Address Extraction ───────────────
# Only needed if you want LLM-based address extraction from transcripts.
# OPENAI_API_KEY=sk-your-openai-key

# ─────────────── Optional: Whisper Transcription ───────────────
# Only needed if using OpenAI Whisper for transcription.
# Set to 'local' to use local Whisper, or provide an API key.
# WHISPER_MODEL=base
# WHISPER_API_KEY=your-whisper-api-key

# ─────────────── Optional: Debug Mode ───────────────
# Set to "true" to enable Flask debug mode (NOT for production).
# DEBUG=true

# ─────────────── Optional: Internal Docker URLs ───────────────
# Only change these if you're running public_map on a different host.
# PUBLIC_MAP_URL=http://public_map:5000/api/push-call
